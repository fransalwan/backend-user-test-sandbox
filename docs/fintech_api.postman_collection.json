				"body": {
					"mode": "urlencoded",
					"urlencoded": [
						{
							"key": "code",
							"value": "package main\n\nfunc FindDuplicateTransactions(transactions []Transaction) []string {\n\tseen := make(map[string]int64)\n\tduplicates := []string{}\n\tfor _, tx := range transactions {\n\t\thash := tx.HashKey()\n\t\tif prevTime, exists := seen[hash]; exists {\n\t\t\tif tx.Timestamp-prevTime <= 60 {\n\t\t\t\tduplicates = append(duplicates, tx.ID)\n\t\t\t}\n\t\t}\n\t\tseen[hash] = tx.Timestamp\n\t}\n\treturn duplicates\n}",
							"type": "text"
						}
					]
				},
